# Backend
PORT=5100
HOST=127.0.0.1
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
JSON_BODY_LIMIT=10mb

# Database / Supabase. Valori reali solo nel backend locale o nel secret manager.
DATABASE_URL=
DATABASE_POOL_MAX=1
DATABASE_SSL_REJECT_UNAUTHORIZED=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Auth/sessioni
AUTH_SECRET=
AUTH_SESSION_TTL_SECONDS=28800
AUTH_LOGIN_MAX_FAILURES=10

# Frontend. Deve essere l'unica variabile pubblica usata dal browser.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:5100

# Optional: richiesto solo se e attiva la lettura OCR/OpenAI ricette.
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=

# Optional: integrazione Aruba Fatturazione Elettronica, lettura solo da backend.
# Alias compatibili: ARUBA_FE_AUTH_URL, ARUBA_FE_API_URL, ARUBA_FE_SENDER_PIVA, ARUBA_FE_RECEIVER_PIVA.
ARUBA_FE_ENVIRONMENT=demo
ARUBA_FE_USERNAME=
ARUBA_FE_PASSWORD=
ARUBA_FE_AUTH_BASE_URL=
ARUBA_FE_WS_BASE_URL=
ARUBA_FE_SENDER_COUNTRY=IT
ARUBA_FE_SENDER_VATCODE=
ARUBA_FE_RECEIVER_COUNTRY=IT
ARUBA_FE_RECEIVER_VATCODE=
ARUBA_FE_TIMEOUT_MS=10000
ARUBA_FE_SYNC_DELAY_MS=5500
